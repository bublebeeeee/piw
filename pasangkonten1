        <div class="msg err"><?= htmlspecialchars($error) ?></div>
    <?php endif; ?>

    <form method="POST">
        <input type="url" name="url" placeholder="https://contoh.com/file.html" value="<?= htmlspecialchars($url) ?>" required autofocus>
        <button type="submit">⚡ Generate wget</button>
    </form>

    <?php if ($wgetCommand): ?>
        <h2>💻 Perintah wget:</h2>
        <pre id="cmdBox"><?= htmlspecialchars($wgetCommand) ?><button class="copy-btn" onclick="copyCmd()">📋 Copy</button></pre>

        <div class="info">
            <strong>📌 Info:</strong><br>
            • URL asli: <code><?= htmlspecialchars($url) ?></code><br>
            • File output: <code><?= htmlspecialchars(pathinfo(explode(' ', $wgetCommand)[2], PATHINFO_BASENAME)) ?></code>
        </div>
    <?php endif; ?>

    <script>
    function copyCmd() {
        const box = document.getElementById('cmdBox');
        const clone = box.cloneNode(true);
        clone.querySelector('.copy-btn').remove();
        const text = clone.innerText.trim();
        navigator.clipboard.writeText(text).then(() => {
            const btn = box.querySelector('.copy-btn');
            btn.textContent = '✅ Copied!';
            setTimeout(() => btn.textContent = '📋 Copy', 1500);
        });
    }
    </script>
