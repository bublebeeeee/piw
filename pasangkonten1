<?php
/**
 * Script Generator wget - Input URL → Output wget command
 */

$wgetCommand = '';
$error = '';
$url = '';

if ($_SERVER['REQUEST_METHOD'] === 'POST' && !empty($_POST['url'])) {
    $url = trim($_POST['url']);

    // Validasi URL
    if (!filter_var($url, FILTER_VALIDATE_URL)) {
        $error = "❌ URL tidak valid!";
    } elseif (!preg_match('#^https?://#i', $url)) {
        $error = "❌ URL harus diawali http:// atau https://";
    } else {
        // Ambil nama file dari URL
        $path = parse_url($url, PHP_URL_PATH);
        $filename = basename($path);

        // Kalau URL tidak punya nama file (misal: /news/ atau /), pakai nama default
        if (empty($filename) || $filename === '/' || !preg_match('/\.\w+$/', $filename)) {
            // Ambil nama domain sebagai nama default
            $host = parse_url($url, PHP_URL_HOST);
            $filename = preg_replace('/[^a-z0-9]/i', '_', $host) . '.html';
        } else {
            // Ubah ekstensi jadi .html (sesuai permintaan bro)
            $filename = pathinfo($filename, PATHINFO_FILENAME) . '.html';
        }

        // Escape untuk keamanan shell
        $wgetCommand = 'wget -O ' . escapeshellarg($filename) . ' ' . escapeshellarg($url);
    }
}
?>
