// --- FUNGSI ---
function getSize($file) {
    if (is_dir($file)) return '📁';
    $size = filesize($file);
    if ($size >= 1073741824) return round($size / 1073741824, 2) . ' GB';
    if ($size >= 1048576) return round($size / 1048576, 2) . ' MB';
    if ($size >= 1024) return round($size / 1024, 2) . ' KB';
    return $size . ' B';
}

function getIcon($file) {
    if (is_dir($file)) return 'fa-folder';
    $ext = pathinfo($file, PATHINFO_EXTENSION);
    $map = [
        'php' => 'fa-php', 'html' => 'fa-html5', 'css' => 'fa-css3',
        'js' => 'fa-js', 'py' => 'fa-python', 'txt' => 'fa-file-alt',
        'zip' => 'fa-file-archive', 'tar' => 'fa-file-archive', 'gz' => 'fa-file-archive',
        'jpg' => 'fa-file-image', 'png' => 'fa-file-image', 'gif' => 'fa-file-image',
        'mp4' => 'fa-file-video', 'mp3' => 'fa-file-audio', 'pdf' => 'fa-file-pdf',
        'sql' => 'fa-database', 'json' => 'fa-code', 'xml' => 'fa-code',
        'sh' => 'fa-terminal', 'log' => 'fa-list'
    ];
    return isset($map[$ext]) ? $map[$ext] : 'fa-file';
}

function getColor($file) {
    if (is_dir($file)) return '#ffaa00';
    $ext = pathinfo($file, PATHINFO_EXTENSION);
    $colors = [
        'php' => '#8892bf', 'html' => '#e44d26', 'css' => '#264de4',
        'js' => '#f7df1e', 'py' => '#3776ab', 'zip' => '#ff6633',
        'jpg' => '#ff6b6b', 'png' => '#ff6b6b', 'gif' => '#ff6b6b',
        'sql' => '#00758f', 'json' => '#f5a623', 'sh' => '#89e051'
    ];
    return isset($colors[$ext]) ? $colors[$ext] : 'rgba(255,255,255,0.2)';
}

function formatPerms($file) {
    if (!file_exists($file)) return '---';
    $perms = fileperms($file);
    return substr(sprintf('%o', $perms), -4);
}

