<script>
// Terminal auto scroll
var terminal = document.getElementById('terminalOut');
if (terminal) terminal.scrollTop = terminal.scrollHeight;

// Rename Modal
function openRename(path, name) {
    document.getElementById('renameOld').value = path;
    document.getElementById('renameNew').value = name;
    document.getElementById('renameModal').classList.add('active');
    setTimeout(function() {
        document.getElementById('renameNew').focus();
        document.getElementById('renameNew').select();
    }, 100);
}
function closeRename() {
    document.getElementById('renameModal').classList.remove('active');
}
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeRename();
});
</script>

