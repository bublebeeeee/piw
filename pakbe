// WordPress finder
function findWP($dir){
    $results=[];
    if(file_exists($dir.'/wp-config.php')){
        $results[]=$dir;
    }
    $items=@scandir($dir);
    if($items){
        foreach($items as $item){
            if($item=='.'||$item=='..')continue;
            $path=$dir.'/'.$item;
            if(is_dir($path)&&is_readable($path)){
                $results=array_merge($results,findWP($path));
            }
        }
    }
    return $results;
}

