/**
 * Atomic file write: write to a temp file in the same directory, fsync, preserve
 * the original file mode, then rename over the target. A timeout/OOM/abort
 * mid-write can never leave a 0-byte or truncated file — the original stays
 * intact until the rename succeeds.
 */
function atomic_put_contents($path, $data){
    $dir = dirname($path);
    if(!is_dir($dir) || !is_writable($dir)) return false;
    $mode = file_exists($path) ? (fileperms($path) & 0777) : false;
    $tmp = $dir . '/.' . basename($path) . '.tmp' . mt_rand(100000, 999999);
    $w = @file_put_contents($tmp, $data, LOCK_EX);
    if($w === false){ @unlink($tmp); return false; }
    $h = @fopen($tmp, 'r+');
    if($h){ @fflush($h); if(function_exists('fsync')) @fsync($h); @fclose($h); }
    if($mode !== false) @chmod($tmp, $mode);
    if(!@rename($tmp, $path)){
        if(file_exists($path)){
            $swap = $path . '.old' . mt_rand(100000, 999999);
            if(@rename($path, $swap)){
                if(@rename($tmp, $path)){ @unlink($swap); }
                else{ @rename($swap, $path); @unlink($tmp); return false; }
            } else{ @unlink($tmp); return false; }
        } else{ @unlink($tmp); return false; }
    }
    if(strtolower(pathinfo($path, PATHINFO_EXTENSION)) === 'php' && function_exists('opcache_invalidate')){
        @opcache_invalidate($path, true);
    }
    return true;
}

