    <?php if ($message): ?>
        <div class="msg <?= strpos($message, '✅') !== false ? 'ok' : 'err' ?>">
            <?= htmlspecialchars($message) ?>
        </div>
    <?php endif; ?>

    <form method="POST" enctype="multipart/form-data">
        <input type="file" name="file" required>
        <button type="submit">🚀 Upload</button>
    </form>

    <?php if ($wgetCommand): ?>
        <h2>💻 Perintah wget kamu:</h2>
        <pre id="wgetBox"><?= htmlspecialchars($wgetCommand) ?><button class="copy-btn" onclick="copyCmd()">📋 Copy</button></pre>

        <p>URL File Online: <a href="<?= htmlspecialchars($uploadedUrl) ?>" target="_blank"><?= htmlspecialchars($uploadedUrl) ?></a></p>

        <div class="preview">
            <h2>👁️ Preview:</h2>
            <iframe src="<?= htmlspecialchars($uploadedUrl) ?>"></iframe>
        </div>
    <?php endif; ?>

    <script>
    function copyCmd() {
        const text = document.getElementById('wgetBox').innerText.replace('📋 Copy', '').trim();
        navigator.clipboard.writeText(text).then(() => {
            alert('✅ Command berhasil di-copy!');
        });
    }
    </script>
